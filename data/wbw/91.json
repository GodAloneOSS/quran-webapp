{"0":[["بِسْمِ","bis'mi","In (the) name","س م و"],["ٱللَّهِ","l-lahi","(of) God,","ا ل ه"],["ٱلرَّحْمَـٰنِ","l-raḥmāni","Most Gracious,","ر ح م"],["ٱلرَّحِيمِ","l-raḥīmi","Most Merciful.","ر ح م"]],"1":[["وَٱلشَّمْسِ","wal-shamsi","By the sun","ش م س"],["وَضُحَىٰهَا","waḍuḥāhā","and its brightness.","ض ح و"]],"2":[["وَٱلْقَمَرِ","wal-qamari","And the moon","ق م ر"],["إِذَا","idhā","when","ا ذ ا"],["تَلَىٰهَا","talāhā","it followed it.","ت ل و"]],"3":[["وَٱلنَّهَارِ","wal-nahāri","And the day","ن ه ر"],["إِذَا","idhā","when","ا ذ ا"],["جَلَّىٰهَا","jallāhā","it revealed it.","ج ل ل"]],"4":[["وَٱلَّيْلِ","wa-al-layli","And the night","ل ي ل"],["إِذَا","idhā","when","ا ذ ا"],["يَغْشَىٰهَا","yaghshāhā","it covers it.","غ ش ي"]],"5":[["وَٱلسَّمَآءِ","wal-samāi","And the sky","س م و"],["وَمَا","wamā","and that","م ا"],["بَنَىٰهَا","banāhā","He built it.","ب ن ي"]],"6":[["وَٱلْأَرْضِ","wal-arḍi","And the earth","ا ر ض"],["وَمَا","wamā","and that","م ا"],["طَحَىٰهَا","ṭaḥāhā","He spread it / sustained it.","ط ح ا"]],"7":[["وَنَفْسٍ","wanafsin","And (the) soul","ن ف س"],["وَمَا","wamā","and that","م ا"],["سَوَّىٰهَا","sawwāhā","He fashioned it.","س و ي"]],"8":[["فَأَلْهَمَهَا","fa-alhamahā","Then He placed innate knowledge in it (of)","ل ه م"],["فُجُورَهَا","fujūrahā","its evilness / immorality","ف ج ر"],["وَتَقْوَىٰهَا","wataqwāhā","and its righteousness.","و ق ي"]],"9":[["قَدْ","qad","Indeed,","ق د"],["أَفْلَحَ","aflaḥa","successful","ف ل ح"],["مَن","man","one (who)","م ن"],["زَكَّىٰهَا","zakkāhā","he purified it (redeemed his soul).","ز ك و"]],"10":[["وَقَدْ","waqad","And indeed,","ق د"],["خَابَ","khāba","he (will be) unsuccessful / failed","خ ي ب"],["مَن","man","one (who)","م ن"],["دَسَّىٰهَا","dassāhā","he buried / corrupted it.","د س س"]],"11":[["كَذَّبَتْ","kadhabat","[It] denied / rejected","ك ذ ب"],["ثَمُودُ","thamūdu","Thamud","ث م د"],["بِطَغْوَىٰهَآ","biṭaghwāhā","by their transgression.","ط غ و"]],"12":[["إِذِ","idhi","When","ا ذ"],["ٱنۢبَعَثَ","inbaʿatha","it was sent forth","ب ع ث"],["أَشْقَىٰهَا","ashqāhā","(the) most wicked (worst) of them.","ش ق ي"]],"13":[["فَقَالَ","faqāla","But [he] said","ق و ل"],["لَهُمْ","lahum","to them","ل"],["رَسُولُ","rasūlu","(the) messenger","ر س ل"],["ٱللَّهِ","l-lahi","(of) God,","ا ل ه"],["نَاقَةَ","nāqata","\"(It is the) she-camel","ن و ق"],["ٱللَّهِ","l-lahi","(of) God","ا ل ه"],["وَسُقْيَـٰهَا","wasuq'yāhā","and her drinking water.\"","س ق ي"]],"14":[["فَكَذَّبُوهُ","fakadhabūhu","But they denied / rejected him,","ك ذ ب"],["فَعَقَرُوهَا","faʿaqarūhā","and they slaughtered her.","ع ق ر"],["فَدَمْدَمَ","fadamdama","So He annihilated / obliterated","د م د م"],["عَلَيْهِمْ","ʿalayhim","[upon] them","ع ل ي"],["رَبُّهُم","rabbuhum","their Lord","ر ب ب"],["بِذَنۢبِهِمْ","bidhanbihim","for their sin","ذ ن ب"],["فَسَوَّىٰهَا","fasawwāhā","and He leveled them.","س و ي"]],"15":[["وَلَا","walā","Yet not","ل ا"],["يَخَافُ","yakhāfu","he fears","خ و ف"],["عُقْبَـٰهَا","ʿuq'bāhā","its consequences.","ع ق ب"]]}